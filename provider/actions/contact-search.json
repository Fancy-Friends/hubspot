{
  "operation": "contact_search",
  "kind": "contact_search",
  "title": "Search contacts",
  "description": "Find contacts by property filters, sorts or a text query.",
  "summary": "search contacts",
  "docs": "https://developers.hubspot.com/docs/reference/api/crm/objects/contacts",
  "sideEffects": "none",
  "$sideEffectsComment": "A POST that only reads: HubSpot's search endpoint changes nothing.",
  "request": { "method": "POST", "path": "/crm/v3/objects/contacts/search", "encoding": "json" },
  "config": [
    { "type": "json", "key": "filterGroups", "label": "Filter groups", "description": "HubSpot's filterGroups: groups are ORed, filters inside a group are ANDed. Example: [{\"filters\":[{\"propertyName\":\"amount\",\"operator\":\"GT\",\"value\":\"1000\"}]}].", "send": { "in": "body", "as": "filterGroups", "value": "json" } },
    { "type": "json", "key": "sorts", "label": "Sorts", "description": "Example: [{\"propertyName\":\"createdate\",\"direction\":\"DESCENDING\"}].", "send": { "in": "body", "as": "sorts", "value": "json" } },
    { "type": "text", "key": "query", "label": "Text query", "description": "Searches the object's default text properties.", "send": { "in": "body", "as": "query", "value": "string" } },
    { "type": "text", "key": "properties", "label": "Properties", "placeholder": "dealname,amount", "description": "Comma-separated property names to return.", "send": { "in": "body", "as": "properties", "value": "list", "separator": "," } },
    { "type": "number", "key": "limit", "label": "Page size", "description": "1 to 200.", "send": { "in": "body", "as": "limit", "value": "integer", "min": 1, "max": 200 } },
    { "type": "text", "key": "after", "label": "After (cursor)", "description": "The cursor from the previous page's paging.next.after.", "send": { "in": "body", "as": "after", "value": "string" } }
  ],
  "outputShape": [
    { "path": "data.total", "type": "number", "description": "How many records match, across every page." },
    { "path": "data.results", "type": "array", "description": "This page of matching contacts." },
    { "path": "data.results[].id", "type": "string", "description": "HubSpot's contact id. A NUMERIC STRING, not a number; pass it back as given." },
    { "path": "data.results[].properties", "type": "object", "description": "The requested properties, every value a string or null." },
    { "path": "data.results[].createdAt", "type": "string", "description": "ISO 8601 timestamp." },
    { "path": "data.results[].updatedAt", "type": "string", "description": "ISO 8601 timestamp." },
    { "path": "data.results[].archived", "type": "boolean", "description": "FALSE for a live record." },
    { "path": "data.paging.next.after", "type": "string", "description": "Pass this as \"after\" for the next page. Absent on the last page." }
  ],
  "contract": {
    "sends": ["filterGroups", "sorts", "query", "properties", "limit", "after"],
    "reads": ["total", "results", "paging"]
  }
}
