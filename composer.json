{
  "name": "particle-academy/hubspot-php",
  "description": "HubSpot for PHP — the service descriptor, its faker, its webhook verification, and one class per operation. Plain HTTP on particle-academy/fancy-connector-core; no vendor SDK.",
  "type": "library",
  "keywords": [
    "hubspot",
    "crm",
    "connector",
    "api",
    "fancy-ui",
    "particle-academy"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Fancy-Friends/hubspot",
  "support": {
    "issues": "https://github.com/Fancy-Friends/hubspot/issues",
    "source": "https://github.com/Fancy-Friends/hubspot"
  },
  "authors": [
    {
      "name": "Particle Academy",
      "homepage": "https://github.com/Particle-Academy"
    }
  ],
  "require": {
    "php": "^8.4",
    "particle-academy/fancy-connector-core": ">=0.3.1 <2.0"
  },
  "require-dev": {
    "laravel/pint": "^1.26",
    "pestphp/pest": "^3.0|^4.0"
  },
  "autoload": {
    "psr-4": {
      "ParticleAcademy\\Hubspot\\": "packages/php/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ParticleAcademy\\Hubspot\\Tests\\": "packages/php/tests/"
    }
  },
  "scripts": {
    "test": "pest --test-directory=packages/php/tests",
    "lint": "find packages/php -name '*.php' -print0 | xargs -0 -n1 php -l",
    "format": "pint"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
